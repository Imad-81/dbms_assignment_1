generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/prisma_erd.svg"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model admission {
  admission_id        Int                   @id @default(autoincrement())
  patient_id          Int
  admitting_doctor_id Int
  bed_id              Int
  admission_date      DateTime              @default(now()) @db.Timestamptz(6)
  discharge_date      DateTime?             @db.Timestamptz(6)
  admission_reason    String
  discharge_summary   String?
  status              admission_status_type @default(ADMITTED)
  bed                 bed                   @relation(fields: [bed_id], references: [bed_id], onUpdate: NoAction, map: "fk_admission_bed")
  doctor              doctor                @relation(fields: [admitting_doctor_id], references: [doctor_id], onUpdate: NoAction, map: "fk_admission_doctor")
  patient             patient               @relation(fields: [patient_id], references: [patient_id], onUpdate: NoAction, map: "fk_admission_patient")
  bill                bill?

  @@index([bed_id], map: "idx_admission_bed")
  @@index([patient_id], map: "idx_admission_patient")
  @@index([status], map: "idx_admission_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model appointment {
  appointment_id      Int                     @id @default(autoincrement())
  patient_id          Int
  doctor_id           Int
  appointment_date    DateTime                @db.Date
  appointment_time    DateTime                @db.Time(6)
  status              appointment_status_type @default(SCHEDULED)
  appointment_type    appointment_visit_type  @default(NEW_VISIT)
  reason_for_visit    String?
  cancellation_reason String?
  created_at          DateTime                @default(now()) @db.Timestamptz(6)
  doctor              doctor                  @relation(fields: [doctor_id], references: [doctor_id], onUpdate: NoAction, map: "fk_appointment_doctor")
  patient             patient                 @relation(fields: [patient_id], references: [patient_id], onUpdate: NoAction, map: "fk_appointment_patient")
  bill                bill?
  consultation        consultation?

  @@unique([doctor_id, appointment_date, appointment_time], map: "uq_doctor_slot")
  @@index([doctor_id, appointment_date], map: "idx_appointment_doctor_date")
  @@index([patient_id], map: "idx_appointment_patient")
  @@index([status], map: "idx_appointment_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bed {
  bed_id     Int             @id @default(autoincrement())
  ward_id    Int
  bed_number String          @db.VarChar(20)
  status     bed_status_type @default(AVAILABLE)
  is_active  Boolean         @default(true)
  admission  admission[]
  ward       ward            @relation(fields: [ward_id], references: [ward_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bed_ward")

  @@unique([ward_id, bed_number], map: "uq_ward_bed")
  @@index([ward_id, status], map: "idx_bed_ward_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bill {
  bill_id              Int                 @id @default(autoincrement())
  patient_id           Int
  appointment_id       Int?                @unique
  admission_id         Int?                @unique
  bill_date            DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  consultation_charges Decimal             @default(0.00) @db.Decimal(10, 2)
  test_charges         Decimal             @default(0.00) @db.Decimal(10, 2)
  bed_charges          Decimal             @default(0.00) @db.Decimal(10, 2)
  pharmacy_charges     Decimal             @default(0.00) @db.Decimal(10, 2)
  other_charges        Decimal             @default(0.00) @db.Decimal(10, 2)
  discount_amount      Decimal             @default(0.00) @db.Decimal(10, 2)
  tax_amount           Decimal             @default(0.00) @db.Decimal(10, 2)
  total_amount         Decimal             @default(0.00) @db.Decimal(10, 2)
  payment_status       bill_payment_status @default(PENDING)
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  admission            admission?          @relation(fields: [admission_id], references: [admission_id], onUpdate: NoAction, map: "fk_bill_admission")
  appointment          appointment?        @relation(fields: [appointment_id], references: [appointment_id], onUpdate: NoAction, map: "fk_bill_appointment")
  patient              patient             @relation(fields: [patient_id], references: [patient_id], onUpdate: NoAction, map: "fk_bill_patient")
  payment              payment[]

  @@index([patient_id], map: "idx_bill_patient")
  @@index([payment_status], map: "idx_bill_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model consultation {
  consultation_id        Int            @id @default(autoincrement())
  appointment_id         Int            @unique
  patient_id             Int
  doctor_id              Int
  consultation_timestamp DateTime       @default(now()) @db.Timestamptz(6)
  symptoms               String
  clinical_notes         String
  blood_pressure         String?        @db.VarChar(15)
  heart_rate             Int?
  temperature_celsius    Decimal?       @db.Decimal(4, 1)
  spo2_percent           Decimal?       @db.Decimal(4, 1)
  follow_up_date         DateTime?      @db.Date
  created_at             DateTime       @default(now()) @db.Timestamptz(6)
  appointment            appointment    @relation(fields: [appointment_id], references: [appointment_id], onUpdate: NoAction, map: "fk_consultation_appointment")
  doctor                 doctor         @relation(fields: [doctor_id], references: [doctor_id], onUpdate: NoAction, map: "fk_consultation_doctor")
  patient                patient        @relation(fields: [patient_id], references: [patient_id], onUpdate: NoAction, map: "fk_consultation_patient")
  diagnosis              diagnosis[]
  prescription           prescription[]
  test_order             test_order[]

  @@index([patient_id], map: "idx_consultation_patient")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model department {
  department_id      Int        @id @default(autoincrement())
  department_name    String     @unique @db.VarChar(100)
  building_floor     String     @db.VarChar(50)
  head_of_department String?    @db.VarChar(100)
  contact_phone      String?    @db.VarChar(20)
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  doctor             doctor[]
  lab_test           lab_test[]
  ward               ward[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model diagnosis {
  diagnosis_id    Int                      @id @default(autoincrement())
  consultation_id Int
  icd_code        String                   @db.VarChar(20)
  diagnosis_name  String                   @db.VarChar(200)
  diagnosis_type  diagnosis_classification @default(PRIMARY)
  remarks         String?
  created_at      DateTime                 @default(now()) @db.Timestamptz(6)
  consultation    consultation             @relation(fields: [consultation_id], references: [consultation_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_diagnosis_consultation")

  @@index([consultation_id], map: "idx_diagnosis_consultation")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model doctor {
  doctor_id        Int               @id @default(autoincrement())
  department_id    Int
  first_name       String            @db.VarChar(50)
  last_name        String            @db.VarChar(50)
  specialization   String            @db.VarChar(100)
  license_number   String            @unique @db.VarChar(50)
  consultation_fee Decimal           @default(0.00) @db.Decimal(10, 2)
  phone            String            @unique @db.VarChar(20)
  email            String            @unique @db.VarChar(100)
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  admission        admission[]
  appointment      appointment[]
  consultation     consultation[]
  department       department        @relation(fields: [department_id], references: [department_id], onUpdate: NoAction, map: "fk_doctor_department")
  doctor_schedule  doctor_schedule[]
  prescription     prescription[]
  test_order       test_order[]

  @@index([department_id], map: "idx_doctor_department")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
