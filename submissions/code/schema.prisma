/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model test_order {
  order_id                 Int               @id @default(autoincrement())
  consultation_id          Int
  patient_id               Int
  test_id                  Int
  ordered_by_doctor_id     Int
  order_date               DateTime          @default(now()) @db.Timestamptz(6)
  sample_collected_date    DateTime?         @db.Timestamptz(6)
  result_date              DateTime?         @db.Timestamptz(6)
  test_result              String?
  reference_range_observed String?
  abnormal_flag            lab_abnormal_flag @default(PENDING)
  technician_remarks       String?
  order_status             lab_order_status  @default(ORDERED)
  consultation             consultation      @relation(fields: [consultation_id], references: [consultation_id], onUpdate: NoAction, map: "fk_order_consultation")
  doctor                   doctor            @relation(fields: [ordered_by_doctor_id], references: [doctor_id], onUpdate: NoAction, map: "fk_order_doctor")
  patient                  patient           @relation(fields: [patient_id], references: [patient_id], onUpdate: NoAction, map: "fk_order_patient")
