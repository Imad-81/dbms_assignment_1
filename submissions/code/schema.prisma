/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ward {
  ward_id       Int           @id @default(autoincrement())
  department_id Int
  ward_name     String        @unique @db.VarChar(50)
  ward_type     ward_category @default(GENERAL)
  floor_number  Int
  daily_rate    Decimal       @default(0.00) @db.Decimal(10, 2)
  total_beds    Int           @default(10)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  bed           bed[]
  department    department    @relation(fields: [department_id], references: [department_id], onUpdate: NoAction, map: "fk_ward_department")
}

enum admission_status_type {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

enum appointment_status_type {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum appointment_visit_type {
  NEW_VISIT
  FOLLOW_UP
  EMERGENCY
  ROUTINE_CHECKUP
}

enum bed_status_type {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum bill_payment_status {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
  CANCELLED
}

enum diagnosis_classification {
  PRIMARY
  SECONDARY
  PROVISIONAL
  CONFIRMED
}

enum lab_abnormal_flag {
  NORMAL
  ABNORMAL
  CRITICAL
  PENDING
}

enum lab_order_status {
  ORDERED
  SAMPLE_COLLECTED
  ANALYZING
  COMPLETED
  CANCELLED
}

enum payment_tender_method {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
  INSURANCE
}

enum ward_category {
  GENERAL
  SEMI_PRIVATE
  PRIVATE
  ICU
  CCU
  EMERGENCY
}
